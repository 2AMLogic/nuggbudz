{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuggbudz",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback answers /api/* with index.html before the
    // Worker is ever invoked. `vite dev` routes differently, so the API only
    // breaks once deployed.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Declaring `routes` turns the *.workers.dev name off by default, and that
  // name is the fallback if a custom domain's DNS or certificate is ever broken.
  "workers_dev": true,
  // Wrangler creates the DNS records and certificate for these on deploy, and
  // fails the deploy when the deploying account does not own the zone — which is
  // the guard: the attachment no longer lives only on the dashboard (#78).
  // test/deploy-config.test.ts pins both entries and the line above.
  "routes": [
    { "pattern": "nuggbudz.com", "custom_domain": true },
    { "pattern": "www.nuggbudz.com", "custom_domain": true }
  ],
  // One Durable Object per geohash cell. The cell is the *shard*, not the
  // market: all pairing for a region happens inside a single-threaded object,
  // which is what makes "two buyers claim the same box" impossible by design.
  // Who may pair with whom is then decided by MATCH_RADIUS_METERS below.
  "durable_objects": {
    "bindings": [{ "name": "NUGG_POOL", "class_name": "NuggPool" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NuggPool"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuggbudz",
      "database_id": "681e978e-c782-42b2-ae27-9e9a1a4278a9",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "747a8578350046df8d8c3c0f80851828" }],
  "vars": {
    // The market is the radius; the cell is only the shard it is evaluated in.
    // Two miles, in metres, and this is the one place that number is written:
    // `shared/geo.ts` derives the same default from METERS_PER_MILE, the client
    // is told the figure in `welcome`, and nothing on screen carries its own.
    //
    // Precision 3 (~156 km) so a 2-mile circle sits comfortably inside one
    // shard: at precision 6 the cell (1.2 km) is smaller than the circle's
    // 6.4 km diameter, so the grid — not the walk — would still decide who can
    // pair. Coarse is the safe direction: one object stays authoritative over
    // every candidate it might pair, with no cross-object locking. If per-shard
    // contention ever becomes real, this is the knob to turn first, and the
    // follow-up is neighbour-aware sharding.
    "POOL_CELL_PRECISION": "3",
    "MATCH_RADIUS_METERS": "3219",
    // Pool socket abuse limits (#10).
    // Concurrent sockets one signed-in account may hold open in one shard. Keyed
    // on the account, not the IP, so buyers behind one carrier NAT never share
    // it. An honest buyer needs one socket, or two while a reconnect overlaps.
    "POOL_MAX_SOCKETS_PER_CELL": "3",
    // Upgrade windows (#106). Every pool socket is a fresh upgrade, and since
    // #104 the receiver's handoff tab is one more. Both figures are derived from
    // the venue model below, which `shared/ratelimit.ts` holds as data and
    // test/ratelimit.test.ts recomputes against these lines — change the model
    // there, never just the number here. Each must stay at or under the window
    // in seconds: KV takes one write a second per key, so a window allowing more
    // than that under-counts and can never trip.
    //
    // POOL_UPGRADE_LIMIT is ONE BUYER's window — an account, or a browser's demo
    // cookie — not an address's. The busiest honest minute of one phone: browse
    // 1, turn on precise location 1, join 1, handoff tab 1, back out and rescan
    // 1, leave and rejoin 2, a socket that drops before opening (usePool's probe
    // plus the retry) 2, a page reload 1 = 10. Signed-in upgrades are counted
    // here alone: the per-address window this replaced was the whole room's
    // budget, since every phone on venue Wi-Fi is one address — fifteen pairings
    // in a minute behind one NAT were already at its ceiling of 30.
    "POOL_UPGRADE_LIMIT": "10",
    "POOL_UPGRADE_WINDOW_SECONDS": "60",
    // POOL_ANON_UPGRADE_LIMIT is the ADDRESS window, counted only for upgrades
    // with no session (#150): an anonymous identity is free to mint, so the
    // address is what turns a flood from one machine away before a Durable
    // Object runs. A separate bucket, so a signed-out crowd can never spend a
    // signed-in buyer's budget. Sized for the busiest venue NAT on a deployment
    // that seats demo buyers: 2 pairings a minute at 5 upgrades each (two buddies
    // browse and join, plus the handoff tab) = 10, plus 10 signed-out visitors
    // who only look at the market at 1 each = 20. A reconnect is not in it — the
    // buyer window above is checked in the same decision, and a buyer refused
    // there is never charged here, so one phone can spend at most half of this.
    // Each allowed attempt costs a KV write per window it is counted in (the
    // free tier allows 1,000 a day).
    "POOL_ANON_UPGRADE_LIMIT": "20",
    // Anonymous sockets one address may hold open at once in one shard. The
    // hard backstop behind the window above: every queue change fans a count
    // out to each idle socket, so this bounds what one address can make that
    // cost. Sized for a food court behind one NAT, not for a script. Left keyed
    // on the address by #106 on purpose: what piles up on one address is the
    // thing it bounds, and a fresh anonymous identity costs nothing.
    "POOL_ANON_SOCKETS_PER_IP": "20",
    // A handoff is two taps seconds apart once the buddies are standing
    // together, so five minutes of silence from the second side means the
    // meeting did not happen — the match is disputed rather than settled.
    "PICKUP_CONFIRM_TIMEOUT_MS": "300000",
    // Nothing ages out without these. A queued buyer silent for
    // QUEUE_IDLE_SECONDS is dropped, warned QUEUE_WARN_LEAD_SECONDS earlier so
    // a ping can save them; a match neither side has confirmed inside
    // MATCH_CONFIRM_SECONDS is cancelled. Once one side confirms, the match
    // leaves this window and PICKUP_CONFIRM_TIMEOUT_MS owns it instead, so the
    // two timers can never both be running on the same match.
    "QUEUE_IDLE_SECONDS": "900",
    "QUEUE_WARN_LEAD_SECONDS": "120",
    "MATCH_CONFIRM_SECONDS": "600",
    // Standing is a tiebreak, not a queue order: a buyer who joined within this
    // many seconds of the longest waiter counts as being at the front with them,
    // and only then does a better standing go first. Measured from the longest
    // waiter's own join time, so the set of buyers who can be served ahead of
    // them is fixed when they sit down — which is what keeps the queue
    // starvation-free however busy the cell gets (#8).
    "STANDING_TIEBREAK_SECONDS": "45"
  }
}
